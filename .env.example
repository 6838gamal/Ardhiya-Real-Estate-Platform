# ── Application ──
APP_NAME=أرضية
APP_ENV=development
DEBUG=True

# ── Database ──
DB_USER=ardiya
DB_PASSWORD=ardiya_secret
DB_HOST=db
DB_PORT=5432
DB_NAME=ardiya_db
DATABASE_URL=postgresql+psycopg2://ardiya:ardiya_secret@db:5432/ardiya_db

# ── Localization ──
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en

